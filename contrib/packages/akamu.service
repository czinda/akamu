[Unit]
Description=akamu ACME certificate authority server
Documentation=https://codeberg.org/abbra/akamu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/akamu
Restart=on-failure
RestartSec=5s

# Run as a dedicated system user (create with: useradd -r -s /sbin/nologin akamu)
User=akamu
Group=akamu

# Configuration and data directories
WorkingDirectory=/var/lib/akamu
StateDirectory=akamu
LogsDirectory=akamu
ConfigurationDirectory=akamu

# Restrict capabilities — the server listens on privileged ports via
# CAP_NET_BIND_SERVICE; remove all others.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
