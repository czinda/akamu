# Akamu configuration — generated by Ansible for {{ ansible_fqdn }}.
# Proxied behind IPA's Apache httpd at the {{ akamu_issuer_path }} path prefix.

listen_addr = "unix:{{ akamu_socket_path }}"
base_url    = "https://{{ ansible_fqdn }}{{ akamu_issuer_path }}"

[database]
url             = "{{ akamu_db_url }}"
max_connections = 5

[ca]
key_file  = "{{ akamu_ca_key_file }}"
cert_file = "{{ akamu_ca_cert_file }}"
key_type  = "ec:P-256"
hash_alg  = "sha256"
common_name  = "{{ ipa_domain }} ACME CA"
organization = "{{ ipa_realm }}"

[server]
validate_dnssec = true

# service_name defaults to "HTTP".
[server.gssapi]
gssproxy = true

[admin]
# Bootstrap the IPA admin principal as the first akamu Administrator.
# Remove after the initial operator account is created.
bootstrap_operator_gssapi_principal = "admin@{{ ipa_realm }}"

[admin.gssapi]
gssproxy = true

