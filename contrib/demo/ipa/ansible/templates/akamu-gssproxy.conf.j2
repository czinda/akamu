# gssproxy service entry for akamu — generated by Ansible for {{ ansible_fqdn }}.
# Installed as /etc/gssproxy/20-akamu.conf.

[service/akamu]
  mechs = krb5
  cred_store = keytab:/var/lib/ipa/gssproxy/http.keytab
  cred_store = client_keytab:/var/lib/ipa/gssproxy/http.keytab
  allow_protocol_transition = true
  allow_constrained_delegation = true
  cred_usage = both
  euid = akamu
