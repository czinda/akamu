# Apache proxy config for akamu — generated by Ansible for {{ ansible_fqdn }}.
# Installed as /etc/httpd/conf.d/ipa-acme-proxy.conf.

ProxyPass        {{ akamu_issuer_path }}/  unix:{{ akamu_socket_path }}|http://localhost/  nocanon
ProxyPassReverse {{ akamu_issuer_path }}/  http://localhost/

ProxyPassReverseCookiePath / {{ akamu_issuer_path }}/
ProxyPreserveHost On

RedirectMatch permanent ^{{ akamu_issuer_path }}$ {{ akamu_issuer_path }}/

<Location "{{ akamu_issuer_path }}/">
    AuthType None
    Require all granted

    SSLOptions +StdEnvVars +ExportCertData +StrictRequire
    SSLVerifyClient none

    RequestHeader set X-Forwarded-Proto "https"

    Header always set    X-Content-Type-Options "nosniff"
    Header always append X-Frame-Options "DENY"
    Header always append Content-Security-Policy "frame-ancestors 'none'"
</Location>

RewriteCond %{SERVER_PORT} !^443$
RewriteRule ^{{ akamu_issuer_path }}/(.*)  https://%{HTTP_HOST}{{ akamu_issuer_path }}/$1 [L,R=307,NC]
