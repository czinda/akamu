[Unit]
Description=akamu ACME certificate authority server
Documentation=https://akamu.dev/doc/
# After= without Requires= is intentional: the service starts even when the
# socket unit is absent (e.g. TCP-only or env-var-based deployments).
After=network-online.target akamu.socket
Wants=network-online.target

[Service]
Type=simple
# On first start, generate a quickstart config if none exists.
# Uses the system FQDN and port 9443; override with a manual config.
# ProtectHostname=yes prevents *changing* the hostname; reading it still works.
ExecStartPre=/bin/sh -c '\
    test -f /etc/akamu/config.toml || { \
        _fqdn=$(/usr/bin/hostname -f 2>/dev/null) || _fqdn=""; \
        [ -n "$_fqdn" ] || { echo >&2 "akamu: hostname -f returned empty; set hostname or create /etc/akamu/config.toml manually"; exit 1; }; \
        /usr/bin/akamu init --system -u "https://${_fqdn}:9443"; \
    }'
ExecStart=/usr/bin/akamu serve -c /etc/akamu/config.toml
Restart=on-failure
RestartSec=5s

User=akamu
Group=akamu

# Configuration and data directories
WorkingDirectory=/var/lib/akamu
StateDirectory=akamu
LogsDirectory=akamu
ConfigurationDirectory=akamu
# Creates and owns /run/akamu/ for the Unix domain socket.
# Mode 0710: group members can traverse (required to connect to the socket)
# but non-group users cannot list the directory, limiting information leakage.
RuntimeDirectory=akamu
RuntimeDirectoryMode=0710

# Allow writes to /etc/akamu for first-run key/cert generation under ProtectSystem=strict
ReadWritePaths=/etc/akamu

# Environment
Environment=RUST_LOG=info

# Direct all journal output from this unit to a dedicated journal namespace.
# Audit events are written as structured entries with AKAMU_* fields.
# Query with: journalctl --namespace=akamu
LogNamespace=akamu

# Set file creation mask so the Unix socket is created with mode 0660
# (group-readable for the reverse proxy process).
UMask=0117

# Restrict capabilities — only needed when binding privileged TCP ports directly.
# When using the Unix domain socket (akamu.socket), these can be removed.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
