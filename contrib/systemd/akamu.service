[Unit]
Description=akamu ACME certificate authority server
Documentation=https://codeberg.org/abbra/akamu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/akamu /etc/akamu/config.toml
Restart=on-failure
RestartSec=5s

# Run as a dedicated system user (create with: useradd -r -s /sbin/nologin akamu)
User=akamu
Group=akamu

# Configuration and data directories
WorkingDirectory=/var/lib/akamu
StateDirectory=akamu
LogsDirectory=akamu
ConfigurationDirectory=akamu

# Allow writes to /etc/akamu for first-run key/cert generation under ProtectSystem=strict
ReadWritePaths=/etc/akamu

# Environment
Environment=RUST_LOG=info

# Restrict capabilities — the server may listen on privileged ports
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
