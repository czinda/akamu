[Unit]
Description=akamu MTC cosigner daemon
Documentation=https://akamu.dev/doc/
# After= without Requires= is intentional: the service starts even when the
# socket unit is absent (e.g. TCP-only or env-var-based deployments).
After=network-online.target akamu-cosigner.socket
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/akamu-cosigner /etc/akamu-cosigner/cosigner.toml
Restart=on-failure
RestartSec=5s

User=akamu-cosigner
Group=akamu-cosigner
# Grant write access to /run/akamu/ (owned by akamu:akamu) so the cosigner can
# create its Unix socket there without socket activation.
SupplementaryGroups=akamu

# Configuration and data directories
WorkingDirectory=/var/lib/akamu-cosigner
StateDirectory=akamu-cosigner
LogsDirectory=akamu-cosigner
ConfigurationDirectory=akamu-cosigner

# Allow writes to /etc/akamu-cosigner for first-run key/cert generation and
# dns-hook scripts under ProtectSystem=strict, and to /run/akamu/ for the socket.
# Note: /run/akamu grants write access to the whole directory (including the ACME
# server's socket file). This is the minimum required so the cosigner can create
# its socket file there in config-based (non-socket-activation) deployments.
# Under socket activation this path is not needed; the socket is pre-created by
# systemd before the service starts.  If the cosigner is ever compromised, an
# attacker could replace akamu.sock in that window — mitigated by the socket-type
# check in remove_stale_socket which refuses to delete non-socket files.
ReadWritePaths=/etc/akamu-cosigner /run/akamu

# Environment
Environment=RUST_LOG=info

# Set file creation mask so the Unix socket is created with mode 0660
# (group-readable for the reverse proxy process).
UMask=0117

# Restrict capabilities — only needed when binding privileged TCP ports directly.
# When using the Unix domain socket (akamu-cosigner.socket), these can be removed.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
